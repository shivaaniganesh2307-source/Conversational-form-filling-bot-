{
  "form_name": "employee_onboarding",
  "fields": {
    "first_name": {
      "type": "string",
      "required": true
    },

    "last_name": {
      "type": "string",
      "required": true
    },

    "employee_id": {
      "type": "string",
      "required": true
    },

    "department": {
      "type": "string",
      "required": true
    },

    "is_full_time": {
      "type": "boolean",
      "required": true
    },

    "salary": {
      "type": "number",
      "required": true,
      "condition": {
        "field": "is_full_time",
        "equals": true
      }
    },

    "hourly_rate": {
      "type": "number",
      "required": true,
      "condition": {
        "field": "is_full_time",
        "equals": false
      }
    },

    "needs_laptop": {
      "type": "boolean",
      "required": true
    },

    "laptop_type": {
      "type": "string",
      "required": true,
      "condition": {
        "field": "needs_laptop",
        "equals": true
      }
    }
  }
}