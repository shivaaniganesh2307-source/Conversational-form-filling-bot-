{
  "form_name": "osha_form",
  "fields": {
    "first_name": {
      "type": "string",
      "required": true
    },

    "middle_name": {
      "type": "string",
      "required": true
    },

    "last_name": {
      "type": "string",
      "required": true
    },

    "uic": {
      "type": "string",
      "required": true,
      "validation": "alphanumeric"
    },

    "street_name": {
      "type": "string",
      "required": true
    },

    "city": {
      "type": "string",
      "required": true
    },

    "state": {
      "type": "string",
      "required": true
    },

    "zipcode": {
      "type": "string",
      "required": true
    },

    "date_of_birth": {
      "type": "date",
      "required": true
    },

    "date_hired": {
      "type": "date",
      "required": true
    },

    "date_of_injury_illness": {
      "type": "date",
      "required": true
    },

    "time_employee_started_work": {
      "type": "string",
      "required": false
    },

    "time_of_event": {
      "type": "string",
      "required": false
    },

    "before_incident": {
      "type": "string",
      "required": true
    },

    "what_happened": {
      "type": "string",
      "required": true
    },

    "gender": {
      "type": "string",
      "required": false
    },

    "name_of_physician": {
      "type": "string",
      "required": true
    },

    "facility": {
      "type": "string",
      "required": false
    },

    "facility_street": {
      "type": "string",
      "required": false
    },

    "facility_city": {
      "type": "string",
      "required": false,
      "condition": {
        "field": "facility_street",
        "exists": true
      }
    },

    "facility_state": {
      "type": "string",
      "required": false,
      "condition": {
        "field": "facility_street",
        "exists": true
      }
    },

    "facility_zipcode": {
      "type": "string",
      "required": false,
      "condition": {
        "field": "facility_street",
        "exists": true
      }
    },

    "employee_treated_emergency_room": {
      "type": "boolean",
      "required": true
    },

    "employee_hospitalized_overnight": {
      "type": "boolean",
      "required": true
    }
  }
}