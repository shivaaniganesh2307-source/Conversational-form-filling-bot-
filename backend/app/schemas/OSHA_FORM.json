{
  "form_id": "osha_form",
  "form_name": "OSHA Form",
  "sections": [
    {
      "name": "Personal Information",
      "fields": ["first_name", "middle_name", "last_name", "date_of_birth", "gender"]
    },
    {
      "name": "Employment & Address",
      "fields": ["uic", "date_hired", "street_name", "city", "state", "zipcode"]
    },
    {
      "name": "Incident Details",
      "fields": ["date_of_injury_illness", "time_employee_started_work", "time_of_event", "before_incident", "what_happened"]
    },
    {
      "name": "Medical Treatment & Facility",
      "fields": ["name_of_physician", "facility", "facility_street", "facility_city", "facility_state", "facility_zipcode", "employee_treated_emergency_room", "employee_hospitalized_overnight"]
    }
  ],
  "fields": {
    "first_name": {
      "type": "name",
      "required": true
    },

    "middle_name": {
      "type": "string",
      "required": false
    },

    "last_name": {
      "type": "name",
      "required": true
    },

    "uic": {
      "type": "string",
      "required": true,
      "pattern": "^[A-Za-z0-9]+$"
    },

    "street_name": {
      "type": "string",
      "required": true
    },

    "city": {
      "type": "string",
      "required": true
    },

    "state": {
      "type": "string",
      "required": true
    },

    "zipcode": {
      "type": "string",
      "required": true
    },

    "date_of_birth": {
      "type": "date",
      "required": true
    },

    "date_hired": {
      "type": "date",
      "required": true
    },

    "date_of_injury_illness": {
      "type": "date",
      "required": true
    },

    "time_employee_started_work": {
      "type": "string",
      "required": false
    },

    "time_of_event": {
      "type": "string",
      "required": false
    },

    "before_incident": {
      "type": "string",
      "required": true
    },

    "what_happened": {
      "type": "string",
      "required": true
    },

    "gender": {
      "type": "string",
      "required": false
    },

    "name_of_physician": {
      "type": "string",
      "required": true
    },

    "facility": {
      "type": "string",
      "required": false
    },

    "facility_street": {
      "type": "string",
      "required": false
    },

    "facility_city": {
      "type": "string",
      "required": false,
      "condition": {
        "field": "facility_street",
        "exists": true
      }
    },

    "facility_state": {
      "type": "string",
      "required": false,
      "condition": {
        "field": "facility_street",
        "exists": true
      }
    },

    "facility_zipcode": {
      "type": "string",
      "required": false,
      "condition": {
        "field": "facility_street",
        "exists": true
      }
    },

    "employee_treated_emergency_room": {
      "type": "boolean",
      "required": true
    },

    "employee_hospitalized_overnight": {
      "type": "boolean",
      "required": true
    }
  }
}
